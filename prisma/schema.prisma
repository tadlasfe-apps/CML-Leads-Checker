generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceSystem {
  WEBSITE
  META
  GHL
  ZENOTI
}

enum RecordType {
  INDIVIDUAL_LEAD
  AGGREGATE_REPORT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SyncStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum SyncType {
  API
  CSV
}

enum AuditStatus {
  MATCHED
  MISSING_IN_GHL
  EXTRA_IN_GHL
  MISSING_IN_ZENOTI
  EXTRA_IN_ZENOTI
  MINOR_MISMATCH
  MAJOR_MISMATCH
  NEEDS_MAPPING
  NEEDS_REVIEW
}

enum DiscrepancyLocation {
  NONE
  SOURCE_TO_GHL
  GHL_TO_ZENOTI
  BOTH
  NEEDS_MAPPING
  NEEDS_REVIEW
}

model LeadSourceRecord {
  id                       String      @id @default(cuid())
  sourceSystem             SourceSystem
  recordType               RecordType  @default(INDIVIDUAL_LEAD)
  backendProvider          String?     // GRAVITY_FORMS, META_ADS, GHL, ZENOTI

  externalId               String?
  createdAtSource          DateTime?
  reportDate               DateTime?   // for Meta aggregate rows
  sourceTimezone           String?
  importedAt               DateTime    @default(now())

  // Contact info (not required for Meta aggregate rows)
  firstName                String?
  lastName                 String?
  fullName                 String?
  email                    String?
  phone                    String?
  normalizedEmail          String?
  normalizedPhone          String?

  // Location/service
  clinicLocationRaw        String?
  clinicLocationNormalized String?
  serviceRaw               String?
  serviceNormalized        String?

  // Attribution
  campaignName             String?
  attributedChannel        String?
  leadSource               String?

  // Website Lead fields
  formName                 String?
  formId                   String?
  websiteFormSource        String?     // Popup, Website Quiz, Landing Page Form, etc.
  pageUrl                  String?
  landingPageUrl           String?
  referrerUrl              String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  utmContent               String?
  utmTerm                  String?
  fbclid                   String?
  gravityFormsEntryId      String?
  gravityFormsFormId       String?

  // Meta Ads fields
  metaObjective            String?
  metaConversionGoal       String?
  metaResultType           String?
  metaResults              Float?      // raw results value from Meta reporting
  metaLeadCount            Int?        // computed: metaResults when resultType=Lead, else 0
  spend                    Float?
  costPerResult            Float?
  impressions              Int?
  reach                    Int?
  clicks                   Int?
  linkClicks               Int?
  landingPageViews         Int?
  attributionSetting       String?
  metaCampaignId           String?
  metaAdSetName            String?
  metaAdSetId              String?
  metaAdName               String?
  metaAdId                 String?

  // GHL fields
  ghlContactId             String?
  ghlOpportunityId         String?
  ghlPipelineName          String?
  ghlPipelineId            String?
  ghlStageName             String?
  ghlStageId               String?

  // Zenoti fields
  zenotiLeadId             String?
  zenotiInquiryId          String?
  zenotiProspectId         String?
  zenotiGuestId            String?
  zenotiCenterName         String?
  leadCreatedDate          DateTime?
  inquiryDate              DateTime?
  guestCreatedDate         DateTime?
  appointmentDate          DateTime?   // optional secondary context
  bookingDate              DateTime?   // optional secondary context
  zenotiAppointmentId      String?     // optional secondary context
  appointmentStatus        String?     // optional secondary context

  status                   String?
  isDuplicate              Boolean     @default(false)
  isAppointmentBased       Boolean     @default(false) // flag when Zenoti source is appointment-based only

  rawPayload               Json?
  importBatchId            String?

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  importBatch              ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([sourceSystem, externalId], name: "unique_source_external")
  @@index([sourceSystem])
  @@index([createdAtSource])
  @@index([reportDate])
  @@index([sourceSystem, createdAtSource])
  @@index([sourceSystem, reportDate])
  @@index([clinicLocationNormalized, createdAtSource])
  @@index([serviceNormalized, createdAtSource])
  @@index([websiteFormSource, createdAtSource])
  @@index([formName, createdAtSource])
  @@index([campaignName, createdAtSource])
  @@index([metaResultType, reportDate])
  @@index([metaCampaignId, reportDate])
  @@index([ghlPipelineId, createdAtSource])
  @@index([zenotiCenterName, createdAtSource])
  @@index([zenotiLeadId])
  @@index([zenotiInquiryId])
  @@index([zenotiProspectId])
  @@index([leadCreatedDate])
  @@index([inquiryDate])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([importBatchId])
  @@index([isDuplicate])
}

model ImportBatch {
  id                       String       @id @default(cuid())
  sourceSystem             SourceSystem
  fileName                 String
  uploadedBy               String?
  totalRows                Int          @default(0)
  validRows                Int          @default(0)
  invalidRows              Int          @default(0)
  duplicateRows            Int          @default(0)
  unmappedClinicRows       Int          @default(0)
  unmappedServiceRows      Int          @default(0)
  unmappedFormSourceRows   Int          @default(0)
  importedDateRangeStart   DateTime?
  importedDateRangeEnd     DateTime?
  status                   ImportStatus @default(PENDING)
  errorSummary             Json?
  createdAt                DateTime     @default(now())

  leads                    LeadSourceRecord[]
}

model SyncRun {
  id               String       @id @default(cuid())
  sourceSystem     SourceSystem
  syncType         SyncType     @default(API)
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  status           SyncStatus   @default(RUNNING)
  recordsFetched   Int          @default(0)
  recordsCreated   Int          @default(0)
  recordsUpdated   Int          @default(0)
  recordsSkipped   Int          @default(0)
  errorMessage     String?
  dateRangeStart   DateTime?
  dateRangeEnd     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model IntegrationSettings {
  id           String       @id @default(cuid())
  sourceSystem SourceSystem @unique
  provider     String?
  enabled      Boolean      @default(false)
  config       Json?        // non-secret config (pipeline IDs, form IDs, etc.)
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ClinicMapping {
  id              String   @id @default(cuid())
  rawValue        String   @unique
  normalizedValue String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceMapping {
  id              String   @id @default(cuid())
  rawValue        String   @unique
  normalizedValue String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SourceMapping {
  id              String   @id @default(cuid())
  rawValue        String   @unique
  normalizedValue String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebsiteFormSourceMapping {
  id              String   @id @default(cuid())
  rawValue        String   @unique
  normalizedValue String   // Popup, Website Quiz, Landing Page Form, etc.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebsiteFormNameMapping {
  id              String   @id @default(cuid())
  rawValue        String   @unique
  normalizedValue String
  formId          String?
  backendProvider String?  // GRAVITY_FORMS, etc.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
